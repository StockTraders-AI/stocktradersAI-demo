# Socket.IO namespace /realtime của Realtime Core staging/prod.
# Trên Vercel nên dùng same-origin để tránh mixed content và đi qua rewrite /socket.io.
VITE_SMDT_WS_URL=/realtime
VITE_PORTFOLIO_CHAT_API_URL=/api/portfolio-chat
VITE_GOOGLE_CLIENT_ID=

# Env cho test LOCAL 
# FPT_SMS_BASE_URL=http://sandbox.sms.fpt.net
# FPT_SMS_CLIENT_ID=
# FPT_SMS_CLIENT_SECRET=
# FPT_SMS_BRANDNAME=StockTrader
# FPT_SMS_SCOPE=send_brandname_otp
# FPT_SMS_OTP_TEMPLATE=StockTrader: Ma OTP của bạn trên website AI StockTraders la {OTP}
# FPT_SMS_OTP_SIGNING_SECRET=
# FPT_SMS_DLR_AUTHORIZATION_KEY=your__SMS_DLR_AUTHORIZATION_KEY
# FPT_SMS_DEBUG_LOG=1

# Env server-only cho PRODUCTION. Set trên backend/VPS, không đưa vào bundle FE.
FPT_SMS_BASE_URL=https://api01.sms.fpt.net
FPT_SMS_CLIENT_ID=
FPT_SMS_CLIENT_SECRET=
FPT_SMS_BRANDNAME=StockTrader
FPT_SMS_SCOPE=send_brandname_otp
FPT_SMS_OTP_TEMPLATE=StockTrader: Ma OTP của bạn trên website AI StockTraders la {OTP}
FPT_SMS_OTP_SIGNING_SECRET=
FPT_SMS_DLR_AUTHORIZATION_KEY=your_SMS_DLR_AUTHORIZATION_KEY
FPT_SMS_OTP_PHONE_COOLDOWN_SECONDS=60
FPT_SMS_OTP_PHONE_HOURLY_LIMIT=2
FPT_SMS_OTP_PHONE_DAILY_LIMIT=2
FPT_SMS_OTP_IP_HOURLY_LIMIT=10
FPT_SMS_DEBUG_LOG=0
TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET=

# Env public cho FE production.
VITE_TURNSTILE_SITE_KEY=
# (Hoặc dùng bản HTTP: [http://api01.sms.fpt.net](http://api01.sms.fpt.net) nếu hệ thống không bắt buộc mã hóa SSL khi gọi ra ngoài)
