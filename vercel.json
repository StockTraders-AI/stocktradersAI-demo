{
  "functions": {
    "api/data.js": {
      "maxDuration": 60
    },
    "api/portfolio-chat.js": {
      "maxDuration": 60
    },
    "api/market/portfolio-chat.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/realtime/:path*",
      "destination": "http://112.213.91.235:3005/realtime/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "http://112.213.91.235:3005/socket.io/:path*"
    }
  ]
}
